# Seedance Demo - Environment Variables

# ============== 必需配置 ==============
# 数据库连接（必须配置）
SD_DATABASE_URL=mysql+pymysql://username:password@host:port/database_name

# ============== 首次初始化配置（可选） ==============
# BytePlus API Key - 首次启动时会加密存储到数据库
# 之后修改请通过后台管理界面操作
SD_BYTEPLUS_API_KEY=your-byteplus-api-key-here

# ============== 可选配置 ==============
# JWT密钥（建议修改）
SD_SECRET_KEY=your-secret-key-here-change-in-production

# Redis（可选）
SD_REDIS_URL=redis://localhost:6379/0

# Google OAuth（可选）
SD_GOOGLE_CLIENT_ID=your-google-client-id
SD_GOOGLE_CLIENT_SECRET=your-google-client-secret
SD_GOOGLE_REDIRECT_URI=http://localhost:8908/auth/google/callback
